"type": "pdf", "content": "engenn10le18ob08re7pdf01.pdf"}]}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nAre you the family storyteller?\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 2, "type": "video", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "video", "value": {"video_src": "engenn10le18ob08re2vid01", "images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "<p>My name is John Harris. Thanks for having me. I've decided to tell you a funny experience that I had while traveling through Chile last year. I'm sure I'll have you all in stitches. Anyway, I had been in Santiago, Chile for about a week.  I was hanging out with some other backpackers whom I had met at the youth hostel.  As 20- somethings, we had visited the performing arts centers, attended wine tastings and frequented the charming cafes that lined the streets. At night, we would enjoy Santiago's vibrant club scene. In fact, it would not be uncommon for us to be on the dance floor into the early hours. We were having the time of our lives.</p>", "id": 1, "time": "100", "image": ""}, {"text": "<p>One evening, a member of our trio decided to leave the nightclub earlier than usual to meet a friend. Later, I noticed that my other buddy, Josh, had left too. Consequently, I needed to find my way back to the hostel on my own at 3 a.m. I jumped on a bus outside, and was convinced that my head would be on my hostel pillow within 20 minutes. Next thing I know,  I was alone and locked in the bus. It was pitch black and I had no idea where I was.  \u201cWhy are you dreaming about buses, you fool?\u201d, I muttered to myself.</p>", "id": 2, "time": "38900", "image": ""}, {"text": "<p>I stirred again at sunrise and suddenly realized that I was in an empty bus depot. The driver mustn't have seen me stretched out on the back seat and had locked me inside. I scampered to the driver's seat, desperately searching for buttons that I had seen the driver use to open the main doors. Nothing seemed to work. My best option was to wait it out. Surely, someone would be arriving soon. Lo and behold, an early morning worker came alongside the vehicle when I was in the driver seat. I didn't know what to do or what  to say. I had no doubt that I had some explaining to do. Suddenly he shouted across the yard to his workmates, \u201cVengan r\u00e1pido, un ladr\u00f3n!\u201d</p>", "id": 3, "time": "78200", "image": ""}]}}]}, {"id": 3, "type": "video", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "video", "value": {"video_src": "engenn10le18ob08re3vid01", "images": [{"text": "Narrative Paragraph <br></li><li>Tells us about a series of events, told in a time sequence with a definite beginning, middle and end.<br>\n</li><li>Includes characters and a setting.<br>\n</li><li>Contains a plot (what happens).<br>\n</li><li>Uses strong verbs and adjectives.<br>\n</li><li>Has direct dialogue.<br>\n</li><li>The order of events is important.</li></ul>", "id": 0, "time": "0", "image": ""}]}}]}]}], "type": "sena"}